# LuCI Snort3 application settings.
#
# This file is the canonical configuration for the LuCI application.
# /usr/libexec/snort-web-sync copies the options below to
# /etc/config/snort, which is read by the OpenWrt snort3 init script.
#
# Do not edit /etc/config/snort for application settings: it is owned by
# the snort3 package and will be overwritten on the next apply or boot.

config snort 'snort'
	option enabled '0'
	option manual '1'
	option interface 'br-lan'
	option home_net '192.168.1.0/24'
	option external_net 'any'
	option mode 'ids'
	option method 'pcap'
	option snaplen '1518'
	option logging '1'
	option log_dir '/var/log'
	option config_dir '/etc/snort'
	option temp_dir '/var/snort.d'
	option oinkcode ''
	option action 'default'
	option openappid '0'
	option include ''

config nfq 'nfq'
	option queue_count '4'
	option queue_start '4'
	option queue_maxlen '1024'
	option fanout_type 'hash'
	option thread_count '0'
	option chain_type 'input'
	option chain_priority 'filter'
	option include ''

config internal 'internal'
	option migrated '0'

#!/bin/sh

# Enable the boot-time configuration sync.  This also activates the ucitrack
# trigger when the package is part of a firmware image.
[ -x /etc/init.d/snort-web ] && /etc/init.d/snort-web enable

[ -f /etc/config/snort-web ] || exit 0

# 4.3.0 removed Manual mode (snort3's legacy --tweaks local path, which needs
# a local.lua the package does not ship) and both user Lua include fields.
# Clear the saved values and the runtime copy so an upgraded device cannot
# fall back into the crash-looping legacy configuration.
uci -q set snort-web.snort.manual=0
uci -q delete snort-web.snort.include
uci -q delete snort-web.nfq.include
uci -q commit snort-web

if [ -f /etc/config/snort ]; then
	uci -q set snort.snort.manual=0
	uci -q delete snort.snort.include
	uci -q delete snort.nfq.include
	uci -q commit snort
fi

# Older releases symlinked /etc/snort/rules into tmpfs, so downloaded rules
# disappeared on every reboot.  Move anything still there into a real,
# persistent directory before the first sync of this version.
conf_dir=$(uci -q get snort-web.snort.config_dir 2>/dev/null)
[ -n "$conf_dir" ] || conf_dir=/etc/snort
temp_dir=$(uci -q get snort-web.snort.temp_dir 2>/dev/null)
[ -n "$temp_dir" ] || temp_dir=/var/snort.d
rules="$conf_dir/rules"
tmp_rules="$temp_dir/rules"

copy_rules_from() {
	[ -d "$1" ] || return 0
	for f in "$1"/*.rules; do
		[ -f "$f" ] && cp -f "$f" "$2/"
	done
	return 0
}

if [ -L "$rules" ]; then
	stage="$rules.migrate.$$"
	if mkdir -p "$stage" 2>/dev/null; then
		copy_rules_from "$tmp_rules" "$stage"
		copy_rules_from "$(readlink "$rules" 2>/dev/null)" "$stage"
		rm -f "$rules"
		if [ -n "$(ls -A "$stage" 2>/dev/null)" ]; then
			mv "$stage" "$rules" || mkdir -p "$rules"
		else
			rmdir "$stage" 2>/dev/null || :
			mkdir -p "$rules"
		fi
		logger -t snort-web "migrated rules into persistent $rules" 2>/dev/null || :
	fi
elif [ -d "$rules" ] && ! ls "$rules"/*.rules >/dev/null 2>&1; then
	copy_rules_from "$tmp_rules" "$rules"
fi

# Import an existing /etc/config/snort once and push the application settings
# into the runtime configuration used by the snort3 init script.
[ -x /usr/libexec/snort-web-sync ] && /usr/libexec/snort-web-sync --sync
[ -f /usr/libexec/snort-web-schedule ] && /bin/sh /usr/libexec/snort-web-schedule

exit 0

#!/bin/sh
#
# Built-in Snort3 rules updater for luci-app-snort3.
#
# Called by the luci.snort rpcd backend, by cron (scheduled updates) and by
# the ifup hotplug script (boot-time top-up when rules are not persistent).
#
# snort-web.snort.rules_persist decides where the rules live:
#   1 -> real directory at $config_dir/rules (survives reboot)
#   0 -> $temp_dir/rules in tmpfs, with $config_dir/rules as a symlink
#
# /tmp/snort_rules_update.status holds running/ok/failed and an error code;
# /tmp/snort_rules_update.source records community/registered.

set -u

STATUS_FILE=/tmp/snort_rules_update.status
SOURCE_FILE=/tmp/snort_rules_update.source
COMMUNITY_URL='https://www.snort.org/downloads/community/snort3-community-rules.tar.gz'
SNAPSHOT_VERSION=${SNORT_RULES_SNAPSHOT:-31470}
TESTING=0
COMMUNITY=0
FALLBACK=0
SOURCE=community

log() {
	printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

set_state() {
	printf '%s\n' "$1" > "$STATUS_FILE" 2>/dev/null || true
	if [ -n "${2:-}" ]; then
		printf '%s\n' "$2" >> "$STATUS_FILE" 2>/dev/null || true
	fi
}

fail() {
	log "ERROR: $1"
	set_state failed "$2"
	exit 1
}

usage() {
	cat <<USAGE
Usage: snort-web-rules-update [-c|--community] [-f|--fallback] [-t|--testing]

  -c  Force the free community ruleset (ignore a saved Oinkcode).
  -f  On download failure, install a minimal fallback ruleset instead of
      failing, so Snort can still start when the device boots without Internet.
  -t  Generate synthetic test rules instead of downloading anything.
  -h  Show this help.

Set SNORT_RULES_SNAPSHOT to override the subscriber snapshot version.
USAGE
}

while [ "${1:-}" ]; do
	case "$1" in
		-t|--testing) TESTING=1 ;;
		-c|--community) COMMUNITY=1 ;;
		-f|--fallback) FALLBACK=1 ;;
		-h|--help) usage; exit 0 ;;
		*) usage; exit 1 ;;
	esac
	shift
done

# The backend synchronises snort-web to /etc/config/snort before every update,
# but fall back to the application config so the script also works standalone.
uci_value() {
	key=$1
	default=$2
	value=$(uci -q get "snort.snort.$key" 2>/dev/null || true)
	[ -n "$value" ] || value=$(uci -q get "snort-web.snort.$key" 2>/dev/null || true)
	[ -n "$value" ] || value=$default
	printf '%s' "$value"
}

safe_dir() {
	case "$1" in
		/*) ;;
		*) fail "Not an absolute path: $1" 'invalid_path' ;;
	esac
	case "$1" in
		*..*) fail "Invalid path component: $1" 'invalid_path' ;;
	esac
}

fetch() {
	url=$1
	out=$2

	if command -v curl >/dev/null 2>&1; then
		log 'Downloading with curl.'
		curl -fLsS --connect-timeout 15 --max-time 180 -o "$out" "$url" && return 0
	fi
	if command -v uclient-fetch >/dev/null 2>&1; then
		log 'Downloading with uclient-fetch.'
		uclient-fetch -O "$out" "$url" && return 0
	fi
	if command -v wget >/dev/null 2>&1; then
		log 'Downloading with wget.'
		wget -O "$out" "$url" && return 0
	fi
	return 1
}

# Used for the boot-time top-up and whenever a download fails badly enough
# that Snort would otherwise start with an empty rules directory.
fallback_rules() {
	dest=$1
	copied=0

	if [ -d /etc/snort/builtin_rules ]; then
		for f in /etc/snort/builtin_rules/*.rules; do
			[ -f "$f" ] || continue
			cp -f "$f" "$dest/" && copied=$((copied + 1))
		done
	fi

	if [ "$copied" -eq 0 ]; then
		printf '%s\n' \
			'alert icmp any any <> any any (msg:"FALLBACK TEST ALERT ICMP v4"; icode:0; itype:8; sid:99010;)' \
			> "$dest/fallback.rules"
	fi
}

set_state running

conf_dir=$(uci_value config_dir /etc/snort)
temp_dir=$(uci_value temp_dir /var/snort.d)
oinkcode=$(uci_value oinkcode '')
persist=$(uci -q get snort-web.snort.rules_persist 2>/dev/null || true)
[ "$persist" = "1" ] || persist=0
safe_dir "$conf_dir"
safe_dir "$temp_dir"

rules_link="$conf_dir/rules"
if [ "$persist" = "1" ]; then
	rules_target="$conf_dir/rules"
	new_rules="$conf_dir/.rules-new.$$"
else
	rules_target="$temp_dir/rules"
	new_rules="$temp_dir/.rules-new.$$"
fi
work_dir="$temp_dir/.rules-download.$$"

cleanup() {
	rm -rf "$work_dir" "$new_rules"
}
trap cleanup EXIT INT TERM

mkdir -p "$temp_dir" || fail "Unable to create $temp_dir" 'rules_dir_failed'
mkdir -p "$conf_dir" || fail "Unable to create $conf_dir" 'rules_dir_failed'
rm -rf "$work_dir" "$new_rules"
mkdir -p "$work_dir" "$new_rules" || fail 'Unable to create working directories' 'rules_dir_failed'

if [ "$TESTING" -eq 1 ]; then
	log 'Generating testing rules (no network access).'
	printf '%s\n' \
		'alert icmp any any <> any any (msg:"TEST ALERT ICMP v4"; icode:0; itype:8; sid:99010;)' \
		'alert icmp any any <> any any (msg:"TEST ALERT ICMP v6"; icode:0; itype:33; sid:99011;)' \
		> "$new_rules/testing.rules"
else
	tarball="$work_dir/rules.tar.gz"

	if [ "$COMMUNITY" -eq 1 ] || [ -z "$oinkcode" ]; then
		url="$COMMUNITY_URL"
		SOURCE=community
		log 'Downloading free community rules.'
	else
		url="https://www.snort.org/rules/snortrules-snapshot-${SNAPSHOT_VERSION}.tar.gz?oinkcode=${oinkcode}"
		SOURCE=registered
		log "Downloading subscriber rules (snapshot ${SNAPSHOT_VERSION})."
	fi

	if fetch "$url" "$tarball" && [ -s "$tarball" ] && tar -xzf "$tarball" -C "$work_dir"; then
		find "$work_dir" -type f -name '*.rules' ! -name 'includes.rules' \
			-exec cp -f '{}' "$new_rules/" \; || fail 'Unable to collect rule files' 'extract_failed'
	elif [ "$FALLBACK" -eq 1 ]; then
		log 'Download failed; installing a minimal fallback ruleset.'
		fallback_rules "$new_rules"
	else
		fail 'Unable to download rules (check network, DNS and ca-certificates)' 'download_failed'
	fi
fi

rule_count=$(find "$new_rules" -type f -name '*.rules' | wc -l)
if [ "$rule_count" -eq 0 ] && [ "$FALLBACK" -eq 1 ]; then
	log 'The archive contained no rules; installing a minimal fallback ruleset.'
	fallback_rules "$new_rules"
	rule_count=$(find "$new_rules" -type f -name '*.rules' | wc -l)
fi
[ "$rule_count" -gt 0 ] || fail 'The archive contains no .rules files' 'rules_empty'

for f in "$new_rules"/*.rules; do
	[ -f "$f" ] || continue
	log "  rule: $(basename "$f") ($(wc -c < "$f") bytes)"
done

# Remove the previous rules path before installing the new directory.
if [ -L "$rules_link" ]; then
	rm -f "$rules_link" || fail "Unable to replace $rules_link" 'link_failed'
elif [ -d "$rules_link" ]; then
	backup="${rules_link}.backup.$(date '+%s')"
	mv "$rules_link" "$backup" || fail "Unable to back up $rules_link" 'link_failed'
	log "Backed up the previous rules directory to $backup."
elif [ -e "$rules_link" ]; then
	fail "$rules_link exists and is neither a directory nor a symbolic link" 'link_failed'
fi

if [ -d "$rules_target" ]; then
	rm -rf "$rules_target" || fail "Unable to replace $rules_target" 'rules_dir_failed'
fi

mv "$new_rules" "$rules_target" || fail "Unable to install rules into $rules_target" 'rules_dir_failed'
if [ "$persist" = "0" ]; then
	ln -s "$rules_target" "$rules_link" || fail "Unable to create $rules_link" 'link_failed'
fi
rm -rf "$work_dir"

printf '%s\n' "$SOURCE" > "$SOURCE_FILE" 2>/dev/null || :
printf '%s\n' "$SOURCE" > "$rules_target/.source" 2>/dev/null || :
set_state ok
log "Loaded ${rule_count} rule file(s) into ${rules_target} (persistent=${persist}, source=${SOURCE})."

# snort-mgr enumerates *.rules at render time, so a restart is required.
if pidof snort3 >/dev/null 2>&1 || pidof snort >/dev/null 2>&1; then
	log 'Restarting Snort to load the new rules.'
	/etc/init.d/snort restart >/dev/null 2>&1 ||
		log 'WARNING: Snort restart failed; restart it manually from the Overview page.'
fi

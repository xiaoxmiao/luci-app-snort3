{
	"luci-app-snort3": {
		"description": "Grant access to the Snort3 status, service control, alerts and rules management",
		"read": {
			"ubus": {
				"luci.snort": [ "status", "alerts", "rules" ]
			},
			"uci": [ "snort-web" ]
		},
		"write": {
			"ubus": {
				"luci.snort": [ "service", "rules_update", "rules_fix", "rules_cleanup" ]
			},
			"uci": [ "snort-web" ]
		}
	}
}
